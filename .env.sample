# U2 MCP Server Configuration
# Copy this file to .env and fill in the values for the way you run it.
# Every setting is described in docs/configuration.md.

# =============================================================================
# stdio (`u2-mcp`): one U2 login, all four required
# =============================================================================

U2_HOST=your-server.example.com
U2_USER=your-username
U2_PASSWORD=your-password
U2_ACCOUNT=YOUR_ACCOUNT

# Connection options (defaults shown)
# U2_SERVICE=uvcs            # uvcs (Universe) or udcs (UniData)
# U2_PORT=31438
# U2_SSL=false
# U2_TIMEOUT=30

# =============================================================================
# Safety (both modes; defaults shown)
# =============================================================================

# U2_READ_ONLY=true
# U2_MAX_RECORDS=10000
# U2_QUERY_TIMEOUT=60
# U2_BLOCKED_COMMANDS=DELETE.FILE,CLEAR.FILE,CNAME,CREATE.FILE
# U2_BASIC_FILES=*BP,BP.*

# =============================================================================
# Team mode (`u2-mcp --streamable-http`): U2_SECRET_KEY is required.
# Connections, logins and company sign-in are set on the admin site at /admin.
# =============================================================================

# At least 32 characters. Keep a copy in your vault.
# U2_SECRET_KEY=
# U2_DATA_DIR=/data
# U2_PUBLIC_URL=https://u2-mcp.example.com
# U2_HTTP_HOST=127.0.0.1
# U2_HTTP_PORT=8080
# U2_HTTP_CORS_ORIGINS=          # '*' is refused
# U2_MAX_CONNECTIONS=25
# U2_TOKEN_FRESHNESS_DAYS=30
# U2_ADMIN_ALLOWED_IPS=
# U2_ADMIN_SIGNIN_LIMIT=5
# U2_TRUSTED_PROXIES=
# U2_TLS_CERT=
# U2_TLS_KEY=
# U2_TOKEN_EXPIRY_SECONDS=3600
# U2_REFRESH_TOKEN_EXPIRY_SECONDS=2592000
